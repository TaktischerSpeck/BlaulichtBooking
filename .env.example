# Plesk: leave APP_KEY empty to use the browser setup assistant.
# Set a private setup code (at least 16 characters); choose all remaining settings in the browser.
SETUP_TOKEN=
APP_DATA_DIR=./data
APP_KEY=
NODE_ENV=development
BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Set to 1 only behind exactly one trusted reverse proxy. Never expose the app port publicly in this case.
TRUST_PROXY=0
DATABASE_PATH=./data/booking.sqlite
# Optional direct configuration instead of the browser assistant:
# DB_CLIENT=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false
SITE_NAME=Feuerwehr Ober-Ramstadt
# Required on the first start only. No default credentials are provided.
INITIAL_PIN=
ADMIN_USERNAME=
ADMIN_PASSWORD=
RETENTION_DAYS=365

# SMTP: port 587 uses mandatory STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=BlaulichtBooking

# Service account with write access to each vehicle's private calendar.
# Keep the quoted PEM on one line, using literal \n between lines.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
